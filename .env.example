# Machine-specific configuration read by ./run (copy this file to .env; .env is git-ignored).
# A variable already set in the real environment wins over this file. Every value has a default,
# so an empty .env is valid. The meaning of each variable: docs/development.md, "Environment variables".

# Steinberg VST3 validator executable (built from the VST3 SDK). Default: `validator` on PATH.
#KCF_VALIDATOR=/path/to/vst3sdk/build/bin/Release/validator

# Tracktion pluginval executable. Default: `pluginval` on PATH, then external/pluginval/ (./run fetch-pluginval).
#KCF_PLUGINVAL=/path/to/pluginval

# Steinberg editorhost executable (macOS and Windows). Default: external/editorhost/ (./run fetch-editorhost).
#KCF_EDITORHOST=/path/to/editorhost

# REAPER executable for the host harness. Default: /usr/sbin/reaper
#KCF_REAPER=/opt/reaper/reaper

# Parallel compiler jobs. Default 1 (an 8 GB machine with a JUCE unity build and LTO); a CI
# runner sets its core count.
#KCF_JOBS=1

# X displays: the tests use DISPLAY (default :104), the REAPER harness KCF_DISPLAY (default :102).
#DISPLAY=:104
#KCF_DISPLAY=:102
